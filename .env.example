# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (required for persistent orders)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/teamservices?retryWrites=true&w=majority

# Admin dashboard login
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password
JWT_SECRET=replace_with_a_long_random_secret

# Browser origins allowed when frontend/backend are deployed separately.
# For same-origin deployment you may leave this blank.
FRONTEND_ORIGIN=http://localhost:5000

# Optional SMTP. Orders are still saved in MongoDB when SMTP is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
TEAM_EMAIL=teamfordeveloper@gmail.com
MAIL_FROM=@TEAM <no-reply@example.com>
